# Copy to .env for local overrides (never commit .env).

# Production: a Postgres connection string (Neon, Render, Railway, Supabase...).
# Leave empty locally to use the built-in embedded database in ./.data/pglite
DATABASE_URL=

# The account that signs up with this email becomes an admin.
# If empty, the first account created becomes the admin.
ADMIN_EMAIL=

# Share this code with educators so they can create educator accounts.
# If empty, educators are promoted by an admin on the Admin page.
EDUCATOR_SIGNUP_CODE=

PORT=3000
NODE_ENV=production
